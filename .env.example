# PostgreSQL connection string (Neon). Used by @prisma/adapter-pg + pg.
# Use sslmode=verify-full to keep strict certificate verification and avoid the
# pg-connection-string SSL-mode deprecation warning.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
