generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  VISITOR
}

enum YearGroup {
  YEAR_7
  YEAR_8
  YEAR_9
  YEAR_10
  YEAR_11
  YEAR_12
}

enum ProblemDifficulty {
  easy
  medium
  hard
  olympiad
}

enum ProblemSource {
  bank
  generated
  ai
  custom
}

enum ProblemCollection {
  bank
  lab
}

enum TaxonomyLevel {
  branch
  topic
  subtopic
  concept
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentType {
  FLASHCARD
  PROBLEM
  HOMEWORK
  QUIZ
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
}

enum WhiteboardAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum PriceType {
  MONTHLY      
  WEEKLY    
  BIWEEKLY     
  PER_LESSON   
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(VISITOR)
  imageUrl      String?
  phone         String?   
  parentPhone   String?   
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coursesTaught        Course[]               @relation("CourseTeacher")
  enrollments          Enrollment[]
  problems             Problem[]
  problemFamilies      ProblemFamily[]
  problemSets          ProblemSet[]
  submissions          Submission[]
  targetedAssignments  Assignment[]           @relation("TargetedStudent")
  comments             Comment[]
  gradesGiven          Grade[]                @relation("GradedBy")
  attendance           Attendance[]
  lessonNotes          LessonNote[]
  whiteboardsAsStudent WhiteboardAssignment[] @relation("WhiteboardStudent")
  whiteboardsAsTeacher WhiteboardAssignment[] @relation("WhiteboardTeacher")
  journalEvents        JournalEvent[]

  paymentsMade         Payment[] @relation("StudentPayments")
  paymentsRecorded     Payment[] @relation("PaymentRecorder")

  individualStudents IndividualStudent[] @relation("TeacherIndividualStudents")


  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@map("verification_tokens")
}

model Course {
  id          String    @id @default(cuid())
  slug        String    @unique
  inviteCode  String?   @unique
  title       String
  description String    @db.Text
  yearGroup   YearGroup
  locale      String    @db.VarChar(8)
  teacherId   String
  teacher     User      @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  defaultMonthlyPrice Decimal @default(0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollments           Enrollment[]
  assignments           Assignment[]
  problemSets           ProblemSet[]
  attendance            Attendance[]
  lessonNotes           LessonNote[]
  whiteboardAssignments WhiteboardAssignment[]
  whiteboard            CourseWhiteboard?

  @@index([teacherId])
  @@map("courses")
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  courseId      String
  monthlyPrice  Decimal?         @db.Decimal(10, 2)
  priceType     PriceType        @default(MONTHLY)   // ← ახალი
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons LessonSlot[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonSlot {
  id           String @id @default(cuid())
  enrollmentId String
  dayOfWeek    Int    // 1=ორშ ... 7=კვი
  startTime    String @db.VarChar(5)  // "16:00"
  endTime      String @db.VarChar(5)  // "17:30"

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([dayOfWeek])
  @@map("lesson_slots")
}

model Payment {
  id           String         @id @default(cuid())
  studentId    String
  monthKey     String         @db.VarChar(7)
  amount       Decimal        @db.Decimal(10, 2)
  method       PaymentMethod?
  note         String?        @db.Text
  recordedById String?
  paidAt       DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student    User  @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([monthKey])
  @@index([studentId])
  @@map("payments")
}

model Problem {
  id             String            @id @default(cuid())
  authorId       String
  templateId     String
  topic          String            @db.VarChar(64)
  difficulty     ProblemDifficulty
  yearGroup      YearGroup?
  source         ProblemSource
  collection     ProblemCollection @default(bank)
  originId       String?
  instructionId  String
  promptTex      String            @db.Text
  solutionTex    String            @db.Text
  seed           Int?
  graphExpr      String?           @db.Text
  kind           String?
  formula        String?           @db.Text
  variables      Json?
  promptTemplate String?           @db.Text
  branchId       String?
  topicNodeId    String?
  subtopicId     String?
  conceptId      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  author    User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  items     ProblemSetItem[]
  branch    TaxonomyNode?    @relation("ProblemBranch", fields: [branchId], references: [id], onDelete: SetNull)
  topicNode TaxonomyNode?    @relation("ProblemTopic", fields: [topicNodeId], references: [id], onDelete: SetNull)
  subtopic  TaxonomyNode?    @relation("ProblemSubtopic", fields: [subtopicId], references: [id], onDelete: SetNull)
  concept   TaxonomyNode?    @relation("ProblemConcept", fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([authorId, topic, difficulty])
  @@index([authorId, collection])
  @@index([authorId, collection, originId])
  @@index([yearGroup, source])
  @@index([branchId])
  @@index([topicNodeId])
  @@index([subtopicId])
  @@index([conceptId])
  @@map("problems")
}

model TaxonomyNode {
  id        String        @id @default(cuid())
  level     TaxonomyLevel
  slug      String        @db.VarChar(64)
  nameKa    String        @db.VarChar(120)
  nameEn    String        @db.VarChar(120)
  nameRu    String        @db.VarChar(120)
  parentId  String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parent   TaxonomyNode?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaxonomyNode[] @relation("TaxonomyTree")

  problemsAsBranch   Problem[] @relation("ProblemBranch")
  problemsAsTopic    Problem[] @relation("ProblemTopic")
  problemsAsSubtopic Problem[] @relation("ProblemSubtopic")
  problemsAsConcept  Problem[] @relation("ProblemConcept")

  @@unique([parentId, slug])
  @@index([level, parentId])
  @@index([sortOrder])
  @@map("taxonomy_nodes")
}

model ProblemFamily {
  id            String   @id @default(cuid())
  authorId      String
  slug          String   @db.VarChar(64)
  title         String   @db.VarChar(120)
  topic         String   @db.VarChar(64)
  instructionId String   @db.VarChar(64)
  template      Json
  parentId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent   ProblemFamily?  @relation("FamilySubtitles", fields: [parentId], references: [id], onDelete: Restrict)
  children ProblemFamily[] @relation("FamilySubtitles")

  @@unique([authorId, slug])
  @@index([authorId, topic])
  @@index([authorId, parentId])
  @@map("problem_families")
}

model ProblemSet {
  id        String   @id @default(cuid())
  title     String
  slug      String
  authorId  String
  courseId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  items       ProblemSetItem[]
  assignments Assignment[]

  @@unique([authorId, slug])
  @@index([authorId])
  @@index([courseId])
  @@map("problem_sets")
}

model ProblemSetItem {
  id        String @id @default(cuid())
  setId     String
  problemId String
  position  Int

  set     ProblemSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  problem Problem    @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@unique([setId, problemId])
  @@index([problemId])
  @@map("problem_set_items")
}

model Assignment {
  id            String           @id @default(cuid())
  courseId      String
  problemSetId  String?
  targetUserId  String?
  type          AssignmentType   @default(PROBLEM)
  title         String
  instructions  String?          @db.Text
  customPayload Json?
  status        AssignmentStatus @default(DRAFT)
  dueAt         DateTime?
  publishedAt   DateTime?
  attachmentUrl String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  problemSet  ProblemSet?  @relation(fields: [problemSetId], references: [id], onDelete: SetNull)
  targetUser  User?        @relation("TargetedStudent", fields: [targetUserId], references: [id], onDelete: SetNull)
  submissions Submission[]
  comments    Comment[]

  @@index([courseId, status])
  @@index([problemSetId])
  @@index([targetUserId])
  @@map("assignments")
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  status        SubmissionStatus @default(DRAFT)
  answers       Json?
  attachmentUrl String?          @db.Text
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Comment {
  id           String   @id @default(cuid())
  assignmentId String
  authorId     String
  body         String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([authorId])
  @@map("comments")
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  graderId     String
  score        Decimal  @db.Decimal(6, 2)
  maxScore     Decimal  @db.Decimal(6, 2)
  comment      String?  @db.Text
  gradedAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader     User       @relation("GradedBy", fields: [graderId], references: [id], onDelete: Restrict)

  @@index([graderId])
  @@map("grades")
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  date      DateTime @db.Date
  present   Boolean  @default(true)
  note      String?

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
  @@index([studentId])
  @@map("attendance")
}

model LessonNote {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  date      DateTime @db.Date
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([courseId, date])
  @@map("lesson_notes")
}

model WhiteboardAssignment {
  id        String                     @id @default(cuid())
  courseId  String
  studentId String
  teacherId String
  title     String
  content   Json
  status    WhiteboardAssignmentStatus @default(ASSIGNED)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("WhiteboardStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User   @relation("WhiteboardTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([teacherId])
  @@index([courseId])
  @@map("whiteboard_assignments")
}

model CourseWhiteboard {
  id               String   @id @default(cuid())
  courseId         String   @unique
  pages            Json
  currentPageIndex Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_whiteboards")
}

model JournalEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  date        String
  allDay      Boolean  @default(false)
  startTime   String   @default("09:00")
  endTime     String   @default("10:00")
  location    String   @default("")
  description String   @default("") @db.Text
  guests      String[] @default([])
  participants Json?                        // ← რჩება (მოსწავლეების სია)
  metadata    Json?                         // ← ახალი: სრული snapshot
  color       String   @default("navy")
  repeat      String   @default("none")
  reminder    String   @default("30")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("journal_events")
}

model IndividualStudent {
  id            String    @id @default(cuid())
  teacherId     String
  firstName     String
  lastName      String
  phone         String?
  parentPhone   String?
  email         String?
  monthlyPrice  Decimal   @default(0) @db.Decimal(10, 2)
  priceType     PriceType @default(MONTHLY)
  note          String?   @db.Text
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher  User                @relation("TeacherIndividualStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  lessons  IndividualLesson[]
  payments IndividualPayment[]

  @@index([teacherId])
  @@map("individual_students")
}

model IndividualLesson {
  id        String @id @default(cuid())
  studentId String
  dayOfWeek Int
  startTime String @db.VarChar(5)
  endTime   String @db.VarChar(5)

  student IndividualStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("individual_lessons")
}

model IndividualPayment {
  id        String         @id @default(cuid())
  studentId String
  amount    Decimal        @db.Decimal(10, 2)
  paidAt    DateTime       @default(now())
  monthKey  String         @db.VarChar(7)
  method    PaymentMethod?
  note      String?        @db.Text
  createdAt DateTime       @default(now())

  student IndividualStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, monthKey])
  @@index([studentId, paidAt])
  @@map("individual_payments")
}